################################################################################
# SNTRUP implementation

ccflags-$(CONFIG_LEANCRYPTO_KEM_SNTRUP) += -I$(src)/../sntrup/src

leancrypto-$(CONFIG_LEANCRYPTO_KEM_SNTRUP)				       \
				+= ../sntrup/src/decode_int16.o		       \
				   ../sntrup/src/encode_int16.o		       \
				   ../sntrup/src/sntrup_kem_api.o	       \
				   ../sntrup/src/sort_int32.o		       \
				   ../sntrup/src/sort_uint32.o		       \
				   ../drng/src/selftest_rng.o

leancrypto-$(CONFIG_LEANCRYPTO_KEM_SNTRUP_1277)				       \
				+= ../sntrup/src/core_invsntrup.o	       \
				   ../sntrup/src/core_inv3sntrup.o	       \
				   ../sntrup/src/core_mult3sntrup.o	       \
				   ../sntrup/src/core_multsntrup.o	       \
