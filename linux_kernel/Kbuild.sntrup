################################################################################
# AVX2 Implementation
################################################################################
ifdef CONFIG_X86_64

leancrypto-$(CONFIG_LEANCRYPTO_KEM_SNTRUP)				       \
				+= ../sntrup/src/avx2/ntt.o

sntrup_avx2_args = -mavx2 -mbmi2 -mpopcnt
CFLAGS_../sntrup/src/avx2/ntt.c	=			 $(sntrup_avx2_args)

leancrypto-$(CONFIG_LEANCRYPTO_KEM_SNTRUP_1277)				       \
				+= ../sntrup/src/avx2/core_invsntrup.o	       \
				   ../sntrup/src/avx2/core_scale3sntrup.o      \
				   ../sntrup/src/avx2/core_weightsntrup.o      \
				   ../sntrup/src/avx2/core_wforcesntrup.o      \
				   ../sntrup/src/avx2/decode_x3.o	       \
				   ../sntrup/src/avx2/encode_x3.o	       \
				   ../sntrup/src/avx2/encode_xfreeze.o	       \
				   ../sntrup/src/avx2/verify.o		       \
				   ../sntrup/src/1277/avx2/core_inv3sntrup_1277.o\
				   ../sntrup/src/1277/avx2/core_mult3sntrup_1277.o\
				   ../sntrup/src/1277/avx2/core_multsntrup_1277.o\
				   ../sntrup/src/1277/avx2/decode_1277x2627.o   \
				   ../sntrup/src/1277/avx2/decode_1277x7879.o   \
				   ../sntrup/src/1277/avx2/encode_1277x2627round.o\
				   ../sntrup/src/1277/avx2/encode_1277x7879.o

