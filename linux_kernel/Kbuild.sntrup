				   ../sntrup/src/core_weightsntrup.o	       \
				   ../sntrup/src/core_wforcesntrup.o	       \
				   ../sntrup/src/decode_x3.o		       \
				   ../sntrup/src/decode_xint16.o	       \
				   ../sntrup/src/decode_xint32.o	       \
				   ../sntrup/src/encode_x3.o		       \
				   ../sntrup/src/encode_xfreeze.o	       \
				   ../sntrup/src/encode_xint16.o	       \
				   ../sntrup/src/sntrup_kem.o		       \
